<class name="CObjectSoundAndFXComponent">
	<inherit name="CEntityComponent" />
	<object name="Impact">
		<field name="matimpDropImpact" type="Id64"/>
		<field name="fSpeedForMaxDropImpactVolume" type="Float32"/>
		<field name="fMinimalCollisionSpeed" type="Float32"/>
		<field name="bIsSingleDropImpactObject" type="Boolean"/>
		<object name="MovementSound">
			<field name="sndRollingSound" type="String"/>
			<field name="sndRollingSoundEnd" type="String"/>
			<field name="sndtpRollingSoundType" type="UInt32"/>
			<field name="sndSlidingSound" type="String"/>
			<field name="sndSlidingSoundEnd" type="String"/>
			<field name="sndtpSlidingSoundType" type="UInt32"/>
			<field name="sndmlObjectMovementMultilayer" type="Int32"/>
		</object>
	</object>
	<object name="Falling">
		<field name="bAllowAfterCollision" />
		<field name="sndFallingSound" type="String"/>
		<field name="sndtpFallingType" type="UInt32"/>
		<field name="fSpeedToPlayFallingSound" type="Float32"/>
		<field name="FallingSoundTimeTrigger" type="Int32"/>
	</object>
	<object name="Water">
		<field name="fZMinSpeedToTriggerSplash" />
		<field name="fZMaxSpeedToTriggerSplash" />
		<field name="fZMinSplashScale" />
		<field name="fZMaxSplashScale" />
		<field name="fZSpeedForMaxSplashVolume" />
	</object>
	<field name="hidCanPlayFallingSound" />
	<field name="hidLastVelocity" />
	<field name="hidWaterSplashTimer" />
</class>