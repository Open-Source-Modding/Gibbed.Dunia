<class name="CCreatureSoundAndFXComponent">
	<inherit name="CEntityComponent" />
        <object name="CreatureSoundAndFXComponent">
          <object name="Collision">
            <field name="fTimeBetweenImpacts" type="Float32" />
            <field name="fSmallCollisionSpeed" type="Float32" />
            <field name="fMediumCollisionSpeed" type="Float32" />
            <field name="fBigCollisionSpeed" type="Float32" />
            <field name="sndtpImpactSoundType" type="Int32" />
            <field name="sndSmallCollision" type="String" />
            <field name="sndMediumCollision" type="String" />
            <field name="sndBigCollision" type="String" />
          </object>
          <object name="ParticleSettings">
            <field name="fParticleMaxSpeed" type="Float32" />
            <field name="fParticleMinSizeRatio" type="Float32" />
            <field name="bDisableSplashFX" type="Boolean" />
            <object name="IdleParticle">
              <field name="text_psFile" type="String" />
              <field name="psFile" type="Hash64" />
              <field name="fScale" type="Float32" />
              <field name="vectorOffset" type="Vector3" />
            </object>
          </object>		  
          </object>
</class>